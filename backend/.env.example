DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pmsdb
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Render sets DATABASE_URL from the managed Postgres connection string.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=
# Where guest sign-in links point — the PUBLIC SITE, not this API. Without it
# links are built for localhost and no guest can sign in.
# The PUBLIC site where emailed sign-in links land - not the API, and not
# localhost. `manage.py check --deploy` refuses to pass if this is unset or
# points at a local address while DEBUG is off.
GUEST_PORTAL_URL=

# The direct-booking endpoint's payment step is a stub: it writes a confirmed
# reservation recording money nothing took. Leave this off until a real payment
# provider is wired in.
ONLINE_PAYMENTS_ENABLED=False

MEDIA_ROOT=
COOKIE_SAMESITE=Lax
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# Two-step login verification (email codes).
# Until these are filled in, codes are only printed to the server console, so
# 2FA logins will NOT work in production.
#
#   EMAIL_HOST      = the SMTP SERVER address, NOT your email address.
#                     Gmail: smtp.gmail.com  ·  Outlook: smtp.office365.com
#   EMAIL_HOST_USER = your email address (the account that sends).
#   EMAIL_HOST_PASSWORD = an App Password, NOT your normal login password.
#                     Gmail: Google Account > Security > turn on 2-Step
#                     Verification, then myaccount.google.com/apppasswords.
#                     Paste the 16 characters with no spaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=you@gmail.com

# Set to True only when running behind a trusted reverse proxy (e.g. Render),
# so X-Forwarded-For can be believed for per-IP rate limiting.
TRUST_PROXY_HEADERS=False
